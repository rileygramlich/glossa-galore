# MongoDB connection string. Defaults to a local database if unset.
DATABASE_URL=mongodb://127.0.0.1:27017/glossa-galore

# Required in production. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI: <your site>/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Optional: a full callback URL. By default it is built from the request.
# GOOGLE_CALLBACK=http://localhost:9999/oauth2callback

# Local development only: adds "Continue as test user" to the sign-in page.
# Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=true

