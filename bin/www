#!/usr/bin/env node

const http = require('http')
const app = require('../server')

const port = Number(process.env.PORT) || 9999
app.set('port', port)

const server = http.createServer(app)

server.listen(port, () => console.log(`Glossa Galore listening on http://localhost:${port}`))

server.on('error', err => {
  if (err.syscall !== 'listen') throw err
  if (err.code === 'EACCES') console.error(`Port ${port} requires elevated privileges`)
  else if (err.code === 'EADDRINUSE') console.error(`Port ${port} is already in use`)
  else throw err
  process.exit(1)
})
