<%- include('../partials/header', { title: 'Journal' }) %>
<section class="profile">
  <div class="profile__cover" aria-hidden="true"></div>
  <div class="profile__body">
    <span class="avatar avatar--lg">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="" referrerpolicy="no-referrer">
      <% } else { %>
        <span aria-hidden="true"><%= (user.name || '?')[0] %></span>
      <% } %>
    </span>
    <div class="profile__info">
      <h1><%= user.name %></h1>
      <p class="muted small">Learning since <%= formatDate(user.createdAt) %></p>
    </div>
    <a href="/posts/new" class="btn btn--accent profile__cta">New entry</a>
  </div>
  <nav class="stat-row" aria-label="Your languages">
    <% languages.forEach(lang => { %>
      <a class="stat" href="/learn/<%= lang.code %>">
        <span class="stat__label"><%= lang.native %></span>
        <span class="stat__value"><strong><%= stats[lang.code].known %></strong> known</span>
      </a>
    <% }) %>
  </nav>
</section>

<section class="journal" aria-label="Journal entries">
  <% if (posts.length) { %>
    <% posts.forEach(post => { %>
      <%- include('../partials/post', { post }) %>
    <% }) %>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-state__title">Your journal is empty.</p>
      <p class="muted">Learn a few words, then write a few lines that use them. Anything counts: your morning, a meal, a plan.</p>
      <a href="/posts/new" class="btn btn--ink">Write your first entry</a>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
