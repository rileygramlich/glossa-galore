<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? `${title} · Glossa Galore` : 'Glossa Galore · Learn the words that matter' %></title>
  <meta name="description" content="Flashcards for the 1000 most common words in French, Portuguese and German, plus a journal to put them to use.">
  <meta name="theme-color" content="#f5efe3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1b1712" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Instrument+Sans:wght@400..700&display=swap">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/" aria-label="Glossa Galore home">
        <span class="brand__mark" aria-hidden="true">G</span>
        <span class="brand__name">Glossa Galore</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/learn" class="site-nav__link" <%- path.startsWith('/learn') ? 'aria-current="page"' : '' %>>Learn</a>
        <a href="/feed" class="site-nav__link" <%- path.startsWith('/feed') || path.startsWith('/posts') ? 'aria-current="page"' : '' %>>Journal</a>
      </nav>
      <div class="site-header__account">
        <% if (user) { %>
          <a href="/feed" class="avatar avatar--sm" title="<%= user.name %>">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="" referrerpolicy="no-referrer">
            <% } else { %>
              <span aria-hidden="true"><%= (user.name || '?')[0] %></span>
            <% } %>
          </a>
          <form action="/logout" method="POST">
            <button type="submit" class="link-button">Sign out</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn--small btn--ink">Sign in</a>
        <% } %>
      </div>
    </div>
  </header>
  <main id="main" class="page">
