<%- include('./partials/header', { title: 'Sign in' }) %>
<section class="panel panel--narrow login">
  <span class="brand__mark brand__mark--large" aria-hidden="true">G</span>
  <h1>Sign in</h1>
  <p class="muted">Save your progress in every language and keep a journal of the words you're learning.</p>

  <div class="stack">
    <% if (googleEnabled) { %>
      <a href="/auth/google" class="btn btn--ink btn--large btn--block">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.09a6.6 6.6 0 0 1 0-4.18V7.07H2.18a11 11 0 0 0 0 9.86l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.6 10.6 0 0 0 12 1 11 11 0 0 0 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
        Continue with Google
      </a>
    <% } else { %>
      <p class="notice">Google sign-in isn't set up here yet. Add <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_SECRET</code> to <code>.env</code>.</p>
    <% } %>
    <% if (devLogin) { %>
      <a href="/dev/login" class="btn btn--ghost btn--large btn--block">Continue as test user</a>
    <% } %>
  </div>

  <p class="small muted">Or <a href="/learn">keep practicing as a guest</a>. Your progress is saved on this device and moves to your account when you sign in.</p>
</section>
<%- include('./partials/footer') %>
