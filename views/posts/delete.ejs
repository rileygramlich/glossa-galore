<%- include('../partials/header', { title: 'Delete entry' }) %>
<section class="panel panel--form">
  <p class="kicker">Journal</p>
  <h1>Delete this entry?</h1>
  <p class="muted">Deleting is permanent and can't be undone.</p>
  <%- include('../partials/post', { post, actions: false }) %>
  <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="form__actions">
    <a href="/feed" class="btn btn--ghost">Keep it</a>
    <button type="submit" class="btn btn--danger">Delete entry</button>
  </form>
</section>
<%- include('../partials/footer') %>
